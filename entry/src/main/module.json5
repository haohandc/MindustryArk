{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // !!! FIXME: we can maybe put "car" and "wearable" in here, too, if SDL will run on them and we could test it at some point.
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1",
      "tv"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",

    // PERMISSIONS: Uncomment if your app needs any of these things. Please edit the "reason" text to more-clearly explain why you need access to the feature.
    // Documentation on this section: https://developer.huawei.com/consumer/en/doc/harmonyos-guides/declare-permissions
    // Lists of specific permissions: https://developer.huawei.com/consumer/en/doc/harmonyos-guides/app-permissions
    // Note that READ_PASTEBOARD is a restricted permission, you need to take serious extra steps to use it. https://developer.huawei.com/consumer/en/doc/harmonyos-guides/restricted-permissions#ohospermissionread_pasteboard
    "requestPermissions": [
      //{ "name": "ohos.permission.MICROPHONE", "reason": "$string:perm_reason_MICROPHONE", "usedScene": { "abilities": [ "EntryAbility" ], "when": "inuse" } },
      //{ "name": "ohos.permission.CAMERA", "reason": "$string:perm_reason_CAMERA", "usedScene": { "abilities": [ "EntryAbility" ], "when": "inuse" } },
      // The game is multiplayer-capable: it can join a server and host one.
      //
      // This was commented out until now, and the reason is visible in the logs.
      // The game tried to fetch the community server list at every launch and
      // got, every time:
      //
      //     SocketException: Operation not permitted
      //       at java.base/sun.nio.ch.Net.socket0(Native Method)
      //
      // which is the kernel refusing socket() with EPERM -- exactly what a
      // missing INTERNET grant looks like. So this is not a new feature being
      // switched on; it is a permission that was never declared while the code
      // that needs it was already running and failing.
      //
      // INTERNET is a NORMAL-level permission: granted at install, no
      // requestPermissionsFromUser call, and none of the ACL machinery. The
      // reason string is filled in because the store reviews it.
      { "name": "ohos.permission.INTERNET", "reason": "$string:perm_reason_INTERNET", "usedScene": { "abilities": [ "EntryAbility" ], "when": "inuse" } }
      //{ "name": "ohos.permission.READ_PASTEBOARD", "reason": "$string:perm_reason_READ_PASTEBOARD", "usedScene": { "abilities": [ "EntryAbility" ], "when": "inuse" } },

      // The game reads files the player placed in Download when importing a
      // save or a game-data export, which is why this is needed.
      //
      // ⚠️ RE-EXAMINE BEFORE TRUSTING THE PARAGRAPH BELOW. It was right for a
      //    debug install on HarmonyOS 7 and is now known to be wrong in general
      //    -- see "THE CLAIM THAT TURNED OUT TO BE CONDITIONAL".
      //
      // Not needed (and deliberately absent):
      //   ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY
      // That is the restricted ACL permission for making the writable sandbox
      // executable. An earlier revision declared it, which forced every install
      // to be re-signed with a profile carrying the matching ACL entry -- and
      // made the HAP impossible for anyone else to install. It was measured
      // unnecessary and removed: the JDK ships inside the HAP's lib area, which
      // is executable already, and the sandbox holds only data (the module
      // image is opened by java.base as a file).
      //
      // THE CLAIM THAT TURNED OUT TO BE CONDITIONAL
      //   The sentence that justified the removal was "Executable memory at
      //   runtime is anonymous, which this platform permits without any
      //   permission." Measured 2026-09-22 on a HarmonyOS 6.1.1 (API 24) device,
      //   running the RELEASE-signed package from AppGallery:
      //
      //       !! mmap(RWX) FAILED: errno=22 (Invalid argument)
      //       [1] clear_cache   (CONTROL) -> -1   unexpected
      //       [2] mprotect RW->RX          -> -1   unexpected
      //
      //   The same probe on a HarmonyOS 7 (API 26) tablet, running a
      //   DEBUG-signed package:  mmap works, control returns 22, everything OK.
      //
      //   So "no permission needed" held for {debug install, API 26} and does
      //   not hold outside it. Without anonymous executable memory the JVM's
      //   JIT cannot start, and the launcher stops dead inside
      //   JNI_CreateJavaVM -- which is the "启动即闪退" the AppGallery reviewer
      //   reported. This permission exists for exactly that, and launcher.c
      //   already says so: "The permission covers anonymous executable memory
      //   only."
      //
      //   ⇒ It is a candidate to ADD BACK for the STORE build, where the
      //     objection above does not apply: a store package is ACL-signed
      //     already and is not meant to be sideloaded, so "nobody else can
      //     install it" costs nothing there. See RELEASE-MAINTENANCE.md 2.11.
      //
      // Do not add it back for the local dev loop: this platform blocks mapping
      // a FILE as executable, and that restriction is what forces the JDK to
      // live in the HAP.
      //
      // REMOVED 2026-09-22: ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY.
      //   Measured: it has never once succeeded on either device this project
      //   owns -- on the phone Environment.getUserDownloadDir() throws (the API
      //   is not there), and on the tablet the grant is denied and mkdir returns
      //   EPERM. Nothing that matters to a player walked that path: all three
      //   ways of getting a mod in need NO permission (the system picker, and
      //   DocumentPickerMode.DOWNLOAD), and the game's data lives in the sandbox.
      //   It also drops an authorisation prompt at startup. See
      //   docs/PERMISSIONS.md and docs/LIMITATIONS.md.
      //   The reason string perm_reason_DOWNLOAD is now unreferenced in
      //   resources/ -- harmless, left in place.
      //
      // With this gone the app declares exactly ONE permission: INTERNET.
    ],

    "abilities": [
      {
        "name": "EntryAbility",
        "orientation": "auto_rotation_restricted",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}