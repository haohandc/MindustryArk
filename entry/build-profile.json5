{
  "apiType": "stageMode",
  "buildOption": {
    // Keep debug symbols in the native libraries.
    //
    // The loader reads a 25 MB libjvm_real.so; the packaging step was stripping
    // it to 20 MB. Segment layout is identical either way, so stripping looked
    // harmless -- but that was inference, and every other difference in the load
    // path had already been ruled out by measurement. This is the cheapest one
    // to settle: a single build either breaks the JVM or it does not.
    "nativeLib": {
      "debugSymbol": {
        "strip": false
      }
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      // SDL's own template sets this, with the comment "Otherwise, we load
      // SDL3's data segment twice.  :(" -- which is a real hazard here: the same
      // shared object can end up with two independent mappings in one process
      // (ArkTS loads one copy for its XComponent, the game's library loader may
      // pick another), and two mappings means two sets of static variables.
      // Not emitting a versioned SONAME is upstream's fix for it; use it rather
      // than patching DT_NEEDED by hand afterwards.
      // ---- WHY THE RELEASE BUILD IS NOT OPTIMISED (2026-09-22) -------------
      //
      // The Release buildMode used to compile this native tree at -O2/-O3, and
      // the result CRASHED ON LAUNCH -- but only in the Release configuration.
      // Measured as a three-point series on one device:
      //
      //   release buildMode, optimised        -> SIGSEGV 9 s after launch
      //   release buildMode, unoptimised      -> runs
      //   debug   buildMode                   -> runs
      //
      // Same stripped natives, same ReleaseType, same ArkTS compilation; the
      // only variable was the optimisation level. So a latent defect in this
      // native code (ours or SDL's) only manifests when optimised.
      //
      // ⚠️ THIS IS A WORKAROUND, NOT A FIX. The defect has not been found --
      //    see RELEASE-MAINTENANCE.md 2.10. What is certain is that the
      //    optimised build does not survive a launch, and AppGallery requires a
      //    release build ("使用非release版本的发布包申请上架会被驳回"), so
      //    turning optimisation off is what makes a shippable package.
      //
      // COST: the package grows by about 1.1 MB out of 261 MB (libSDL3.so
      // 1,929,240 -> 3,058,952 B, libmain.so 37,168 -> 45,248 B). Negligible
      // next to the 261 MB payload. The game itself runs in the JVM, so this
      // does not slow it down; only the launcher and SDL are affected.
      //
      // NOTE the value has to be an explicit -O0, and it has to come from
      // OVERRIDING CMAKE_C_FLAGS_RELEASE. Measured both traps:
      //   - setting it EMPTY is not the same as -O0. Empty lets the
      //     toolchain's own optimisation flags apply, and the resulting
      //     package came out byte-for-byte the optimised size (libSDL3.so
      //     1,929,240 B instead of 3,058,952 B) -- i.e. still crashing.
      //   - appending -O0 after the fact would leave that -O2 in front of it.
      // And a flag change alone does not force a rebuild: entry/.cxx holds one
      // CMake cache per product/buildMode, so the native objects have to be
      // cleared for the new flags to reach them.
      "arguments": "-DCMAKE_PLATFORM_NO_VERSIONED_SONAME=1",
      "cppFlags": "",
      // Template default is ["arm64-v8a", "x86_64"]; x86_64 is for emulators.
      // Real devices here are arm64, and dropping x86_64 halves the compile of
      // SDL's ~490 source files. Add it back if you want to test on an emulator.
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      },
      "nativeLib": {
        // Overrides the target-level strip:false above, and ONLY for this
        // buildMode -- measured, not assumed: the same tree built with
        // buildMode=debug carries libjvm_real.so at 25,322,128 B with .symtab
        // and .debug_str, and with buildMode=release at 20,108,408 B with
        // neither. So the pin hashes in verify_hap.py describe debug packages;
        // a store package mismatches on exactly the three natives it strips.
        // That FAIL is the gate working, not a stale expectation -- do not
        // re-pin it. See RELEASE-MAINTENANCE.md 2.2.
        "debugSymbol": {
          "strip": true,
          "exclude": []
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default",
      "output": {
        // Gives entry-default-signed.hap a name that says what it is.
        //
        // This is a HAND-WRITTEN COPY of a name that is derived elsewhere, which
        // is the one thing to remember about it. Bump it together with
        // APP_VERSION in scripts/config.py and versionName in AppScope/app.json5
        // -- those are the three places the version is written down, and
        // verify_hap.py asserts that all three agree, because a download whose
        // file name says one version and whose contents say another is worse
        // than one with no version in the name at all.
        "artifactName": "MindustryArk-v0.2.0.2"
      }
    },
  ]
}
